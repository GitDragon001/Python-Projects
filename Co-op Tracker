import csv
import os
from datetime import datetime


FILE_NAME = "coop_applications.csv"


def create_file():
    if not os.path.exists(FILE_NAME):
        with open(FILE_NAME, "w", newline="") as file:
            writer = csv.writer(file)
            writer.writerow(
                ["Company", "Position", "Date Applied", "Status", "Notes"]
            )


def add_application():
    print("\n===== ADD CO-OP APPLICATION =====")

    company = input("Company name: ").strip()
    position = input("Position: ").strip()

    if company == "" or position == "":
        print("Company and position cannot be empty.")
        return

    date_applied = datetime.now().strftime("%Y-%m-%d")

    print("\nStatus options:")
    print("1. Applied")
    print("2. Interview")
    print("3. Offer")
    print("4. Rejected")

    status_choice = input("Choose status (1-4): ")

    statuses = {
        "1": "Applied",
        "2": "Interview",
        "3": "Offer",
        "4": "Rejected"
    }

    status = statuses.get(status_choice, "Applied")

    notes = input("Notes: ").strip()

    with open(FILE_NAME, "a", newline="") as file:
        writer = csv.writer(file)

        writer.writerow(
            [company, position, date_applied, status, notes]
        )

    print("\nApplication added successfully.")


def view_applications():
    print("\n===== CO-OP APPLICATIONS =====")

    with open(FILE_NAME, "r") as file:
        reader = csv.reader(file)

        next(reader)

        applications = list(reader)

    if not applications:
        print("No applications yet.")
        return

    for number, application in enumerate(applications, start=1):
        company = application[0]
        position = application[1]
        date_applied = application[2]
        status = application[3]
        notes = application[4]

        print(f"\nApplication #{number}")
        print(f"Company: {company}")
        print(f"Position: {position}")
        print(f"Date Applied: {date_applied}")
        print(f"Status: {status}")
        print(f"Notes: {notes}")


def update_status():
    print("\n===== UPDATE APPLICATION STATUS =====")

    with open(FILE_NAME, "r") as file:
        reader = csv.reader(file)

        header = next(reader)
        applications = list(reader)

    if not applications:
        print("No applications available.")
        return

    for number, application in enumerate(applications, start=1):
        print(
            f"{number}. {application[0]} - "
            f"{application[1]} ({application[3]})"
        )

    try:
        choice = int(input("\nChoose application number: "))

        if choice < 1 or choice > len(applications):
            print("Invalid application number.")
            return

    except ValueError:
        print("Please enter a valid number.")
        return

    print("\nNew status:")
    print("1. Applied")
    print("2. Interview")
    print("3. Offer")
    print("4. Rejected")

    status_choice = input("Choose status (1-4): ")

    statuses = {
        "1": "Applied",
        "2": "Interview",
        "3": "Offer",
        "4": "Rejected"
    }

    if status_choice not in statuses:
        print("Invalid status.")
        return

    applications[choice - 1][3] = statuses[status_choice]

    with open(FILE_NAME, "w", newline="") as file:
        writer = csv.writer(file)

        writer.writerow(header)
        writer.writerows(applications)

    print("Application status updated successfully.")


def show_summary():
    total = 0
    applied = 0
    interviews = 0
    offers = 0
    rejected = 0

    with open(FILE_NAME, "r") as file:
        reader = csv.reader(file)

        next(reader)

        for application in reader:
            total += 1

            status = application[3]

            if status == "Applied":
                applied += 1

            elif status == "Interview":
                interviews += 1

            elif status == "Offer":
                offers += 1

            elif status == "Rejected":
                rejected += 1

    print("\n===== APPLICATION SUMMARY =====")
    print(f"Total Applications: {total}")
    print(f"Applied: {applied}")
    print(f"Interviews: {interviews}")
    print(f"Offers: {offers}")
    print(f"Rejected: {rejected}")


def delete_application():
    print("\n===== DELETE APPLICATION =====")

    with open(FILE_NAME, "r") as file:
        reader = csv.reader(file)

        header = next(reader)
        applications = list(reader)

    if not applications:
        print("No applications available.")
        return

    for number, application in enumerate(applications, start=1):
        print(
            f"{number}. {application[0]} - "
            f"{application[1]}"
        )

    try:
        choice = int(input("\nChoose application to delete: "))

        if choice < 1 or choice > len(applications):
            print("Invalid application number.")
            return

    except ValueError:
        print("Please enter a valid number.")
        return

    removed = applications.pop(choice - 1)

    with open(FILE_NAME, "w", newline="") as file:
        writer = csv.writer(file)

        writer.writerow(header)
        writer.writerows(applications)

    print(
        f"{removed[0]} - {removed[1]} deleted successfully."
    )


def show_menu():
    print("\n===== CO-OP TRACKER =====")
    print("1. Add Application")
    print("2. View Applications")
    print("3. Update Application Status")
    print("4. View Application Summary")
    print("5. Delete Application")
    print("6. Exit")


create_file()


while True:
    show_menu()

    try:
        choice = int(input("\nChoose an option (1-6): "))

    except ValueError:
        print("Please enter a number between 1 and 6.")
        continue

    if choice == 1:
        add_application()

    elif choice == 2:
        view_applications()

    elif choice == 3:
        update_status()

    elif choice == 4:
        show_summary()

    elif choice == 5:
        delete_application()

    elif choice == 6:
        print("\nThank you for using Co-op Tracker.")
        print("Goodbye!")
        break

    else:
        print("Please choose a number between 1 and 6.")
